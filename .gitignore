# Apache rewrite rules are inert on GitHub Pages; kept locally only in case
# the site ever moves to a host that reads them.
.htaccess

_to_delete/
.Rhistory

# Full-size screenshots for the game. These are the originals you work from;
# game/build-images.sh turns them into the small art/game/*.webp files the
# site actually serves, and only those get committed.
citylayoutguessr/maps/
citylayoutguessr/easy maps/
citylayoutguessr/medium maps/
citylayoutguessr/hard maps/

# The full-size logo artwork. art/web/citylayoutguessr/logo-*.webp are built
# from it and are what the page loads; the 10 MB original stays local.
citylayoutguessr/citylayoutguessr.png

# The letters as they came out of Gmail — the RTFs and the downloaded photos.
# blog/import-gmail.mjs reads these and writes blog/posts.js and blog/images/,
# which are the versions the site serves; the originals are kept on disk but
# are not the website, and they are large.
blog/part */

# Screenshots and scratch renders made while working on the site. They are
# working files, not the website, and GitHub Pages serves everything in the
# repo — so anything left here is published.
Claude outputs/
_compare.png
*.stale-*

# The pictures you work from. art/build-web.sh turns these into the sizes the
# site serves in art/web, and only those are committed.
art/originals/
